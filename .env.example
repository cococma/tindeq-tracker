# Copy this file to .env and fill in your values:  cp .env.example .env
# .env is gitignored — real credentials never leave your machine.

# ── Database (required) ───────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tindeq
# Your local Postgres role — often your macOS username, e.g. coco
DB_USER=postgres
# Leave empty if your local Postgres has no password
DB_PASSWORD=

# ── AI coach ──────────────────────────────────────────────
# Works out of the box with no keys: if the Claude Code CLI is installed and
# signed in, the coach runs on your claude.ai subscription (COACH_BACKEND=auto).
# Everything below is optional.

# Force a backend: auto (default) | cli | api
#COACH_BACKEND=auto

# Model for the CLI backend: opus | sonnet | haiku — empty = account default
#COACH_CLI_MODEL=opus

# Long-lived token from `claude setup-token`, so the server doesn't depend on
# the macOS Keychain login. Looks like sk-ant-oat01-...
#CLAUDE_CODE_OAUTH_TOKEN=

# Anthropic API key (pay-per-token) — only for the "api" backend.
# Takes precedence over the CLI when set and COACH_BACKEND=auto.
#ANTHROPIC_API_KEY=

# ── Renpho smart scale cloud sync (optional) ──────────────
# Your Renpho app account. Leave empty to use CSV import on the Body page.
#RENPHO_EMAIL=you@example.com
#RENPHO_PASSWORD=
