# ── Database ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tindeq
DB_USER=postgres
DB_PASSWORD=yourpassword

# ── AI coach ──────────────────────────────────────────────
# Default (auto): uses the Claude Code CLI on your claude.ai subscription
# login — nothing to fill in here. Optional overrides:
# COACH_BACKEND=cli|api|auto
# COACH_CLI_MODEL=            # e.g. opus / sonnet; empty = account default
# CLAUDE_CODE_OAUTH_TOKEN=    # from `claude setup-token`, if you don't want
#                             # to rely on the Keychain login
ANTHROPIC_API_KEY=            # only needed for COACH_BACKEND=api

# ── Renpho smart scale cloud sync (optional) ──────────────
RENPHO_EMAIL=
RENPHO_PASSWORD=
